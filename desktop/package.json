{
  "name": "deepdb-desktop",
  "productName": "deepDB",
  "version": "1.5.18",
  "description": "deepDB — database design teaching tools, packaged as a standalone Windows app.",
  "main": "main.js",
  "author": "NyxKy",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "prepare:web": "node build/prepare.mjs",
    "start": "node build/prepare.mjs && electron .",
    "build:exe": "node build/prepare.mjs && electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.deepdb.desktop",
    "productName": "deepDB",
    "copyright": "Copyright © 2026 NyxKy",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "web/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "deepDB-${version}-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "deepDB",
      "artifactName": "deepDB-${version}-win-x64-setup.${ext}"
    },
    "portable": {
      "artifactName": "deepDB-${version}-win-x64.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "NyxKy-N",
        "repo": "deepDB",
        "releaseType": "release"
      }
    ]
  }
}
